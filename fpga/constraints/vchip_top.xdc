## AUTO-GENERATED by tools/nemo_ctl/gen_svh.py --vchip -- do not edit by hand.
## Source: config/nemo_config.yaml (pin_map) + config/exp08_vchip.yaml (virtual chip pins, jumpers).
## Regenerate with: cd tools && python -m nemo_ctl.gen_svh --vchip
## vchip_top = chip_top (controller) + virtual_chip (Dima's SIPO/PISO RTL), EXP-08.
## Package pins from tools/nemo_ctl/fmc_pins.py (= the verified XDC mapping, CLAUDE.md §5).
## Rule (docs/decisions.md 2026-10-26): DRIVE 4 + SLEW SLOW on outputs, PULLDOWN on inputs.
##
## Jumper wires (HTG-FMC headers, P column):
##   J3-3   sipo_in   -> J2-20  virtual chip sipo_in
##   J3-4   clk_sipo  -> J2-21  virtual chip clk_sipo
##   J3-5   cs        -> J2-22  virtual chip cs
##   J3-6   rst_sipo  -> J2-23  virtual chip rst_sipo
##   J3-7   clk_piso  -> J2-24  virtual chip clk_piso
##   J3-8   shift     -> J2-25  virtual chip shift
##   J3-9   rst_piso  -> J2-26  virtual chip rst_piso
##   J3-13  pulse     -> J2-27  virtual chip phirst
##   J3-16  sipo_out  <- J2-28  virtual chip sipo_out
##   J2-17  piso_out  <- J2-29  virtual chip piso_out

## ---- 100 MHz system clock and LD0-LD7 (verified lines, phase7_link_jtag_top.xdc) ----
set_property PACKAGE_PIN Y9 [get_ports {clk}]
set_property IOSTANDARD LVCMOS33 [get_ports {clk}]
create_clock -add -name sys_clk_pin -period 10.00 -waveform {0 5} [get_ports {clk}]
set_property PACKAGE_PIN T22 [get_ports {led[0]}]
set_property PACKAGE_PIN T21 [get_ports {led[1]}]
set_property PACKAGE_PIN U22 [get_ports {led[2]}]
set_property PACKAGE_PIN U21 [get_ports {led[3]}]
set_property PACKAGE_PIN V22 [get_ports {led[4]}]
set_property PACKAGE_PIN W22 [get_ports {led[5]}]
set_property PACKAGE_PIN U19 [get_ports {led[6]}]
set_property PACKAGE_PIN U14 [get_ports {led[7]}]
set_property IOSTANDARD LVCMOS33 [get_ports {led[*]}]

## ---- controller outputs (chip_top chip_out minus DFT) ----
## clk -> LA00_P (J3-0)
set_property PACKAGE_PIN M19 [get_ports {ctl_out[0]}]
## reset -> LA01_P (J3-1)
set_property PACKAGE_PIN N19 [get_ports {ctl_out[1]}]
## set -> LA02_P (J3-2)
set_property PACKAGE_PIN P17 [get_ports {ctl_out[2]}]
## rst_dsa -> LA14_P (J3-14)
set_property PACKAGE_PIN K19 [get_ports {ctl_out[3]}]
## pulse -> LA13_P (J3-13)
set_property PACKAGE_PIN L17 [get_ports {ctl_out[4]}]
## s0_p -> LA10_P (J3-10)
set_property PACKAGE_PIN R19 [get_ports {ctl_out[5]}]
## s1_p -> LA11_P (J3-11)
set_property PACKAGE_PIN N17 [get_ports {ctl_out[6]}]
## s2_p -> LA12_P (J3-12)
set_property PACKAGE_PIN P20 [get_ports {ctl_out[7]}]
## sipo_in -> LA03_P (J3-3)
set_property PACKAGE_PIN N22 [get_ports {ctl_out[8]}]
## clk_sipo -> LA04_P (J3-4)
set_property PACKAGE_PIN M21 [get_ports {ctl_out[9]}]
## cs -> LA05_P (J3-5)
set_property PACKAGE_PIN J18 [get_ports {ctl_out[10]}]
## rst_sipo -> LA06_P (J3-6)
set_property PACKAGE_PIN L21 [get_ports {ctl_out[11]}]
## clk_piso -> LA07_P (J3-7)
set_property PACKAGE_PIN T16 [get_ports {ctl_out[12]}]
## shift -> LA08_P (J3-8)
set_property PACKAGE_PIN J21 [get_ports {ctl_out[13]}]
## rst_piso -> LA09_P (J3-9)
set_property PACKAGE_PIN R20 [get_ports {ctl_out[14]}]
set_property IOSTANDARD LVCMOS18 [get_ports {ctl_out[*]}]
set_property DRIVE 4 [get_ports {ctl_out[*]}]
set_property SLEW SLOW [get_ports {ctl_out[*]}]

## ---- controller inputs (chip_top chip_in) ----
## sipo_out <- LA16_P (J3-16)
set_property PACKAGE_PIN J20 [get_ports {ctl_in[0]}]
## piso_out <- LA17_P (J2-17)
set_property PACKAGE_PIN B19 [get_ports {ctl_in[1]}]
## dft0_buff <- LA18_P (J2-18)
set_property PACKAGE_PIN D20 [get_ports {ctl_in[2]}]
## dft1_buff <- LA19_P (J2-19)
set_property PACKAGE_PIN G15 [get_ports {ctl_in[3]}]
set_property IOSTANDARD LVCMOS18 [get_ports {ctl_in[*]}]
set_property PULLDOWN true [get_ports {ctl_in[*]}]

## ---- virtual chip inputs (PULLDOWN: a missing jumper holds its resets low = in reset) ----
## virtual chip sipo_in <- LA20_P (J2-20)
set_property PACKAGE_PIN G20 [get_ports {vc_in[0]}]
## virtual chip clk_sipo <- LA21_P (J2-21)
set_property PACKAGE_PIN E19 [get_ports {vc_in[1]}]
## virtual chip cs <- LA22_P (J2-22)
set_property PACKAGE_PIN G19 [get_ports {vc_in[2]}]
## virtual chip rst_sipo <- LA23_P (J2-23)
set_property PACKAGE_PIN E15 [get_ports {vc_in[3]}]
## virtual chip clk_piso <- LA24_P (J2-24)
set_property PACKAGE_PIN A18 [get_ports {vc_in[4]}]
## virtual chip shift <- LA25_P (J2-25)
set_property PACKAGE_PIN D22 [get_ports {vc_in[5]}]
## virtual chip rst_piso <- LA26_P (J2-26)
set_property PACKAGE_PIN F18 [get_ports {vc_in[6]}]
## virtual chip phirst <- LA27_P (J2-27)
set_property PACKAGE_PIN E21 [get_ports {vc_in[7]}]
set_property IOSTANDARD LVCMOS18 [get_ports {vc_in[*]}]
set_property PULLDOWN true [get_ports {vc_in[*]}]

## ---- virtual chip outputs ----
## virtual chip sipo_out -> LA28_P (J2-28)
set_property PACKAGE_PIN A16 [get_ports {vc_out[0]}]
## virtual chip piso_out -> LA29_P (J2-29)
set_property PACKAGE_PIN C17 [get_ports {vc_out[1]}]
set_property IOSTANDARD LVCMOS18 [get_ports {vc_out[*]}]
set_property DRIVE 4 [get_ports {vc_out[*]}]
set_property SLEW SLOW [get_ports {vc_out[*]}]

## ---- the virtual chip's pad clocks (as on the chip) ----
## They arrive on ordinary LA_P pins, not clock-capable ones, so the route to the global
## clock buffer is not dedicated: allowed here, the clocks are slow (1000 ns).
create_clock -name vc_clk_sipo -period 1000.000 [get_ports {vc_in[1]}]
set_property CLOCK_DEDICATED_ROUTE FALSE [get_nets {vc_in_IBUF[1]}]
create_clock -name vc_cs -period 1000.000 [get_ports {vc_in[2]}]
set_property CLOCK_DEDICATED_ROUTE FALSE [get_nets {vc_in_IBUF[2]}]
create_clock -name vc_clk_piso -period 1000.000 [get_ports {vc_in[4]}]
set_property CLOCK_DEDICATED_ROUTE FALSE [get_nets {vc_in_IBUF[4]}]
create_clock -name vc_phirst -period 1000.000 [get_ports {vc_in[7]}]
set_property CLOCK_DEDICATED_ROUTE FALSE [get_nets {vc_in_IBUF[7]}]

## ---- JTAG TCK from the BSCANE2 primitive (the PC link, as in phase7_link_jtag_top.xdc) ----
create_clock -name jtag_tck -period 33.333 [get_pins -hierarchical *u_bscan/TCK]
## every clock is independent of the others (the virtual chip's are separate pads)
set_clock_groups -asynchronous -group [get_clocks sys_clk_pin] -group [get_clocks jtag_tck] -group [get_clocks vc_clk_sipo] -group [get_clocks vc_cs] -group [get_clocks vc_clk_piso] -group [get_clocks vc_phirst]
