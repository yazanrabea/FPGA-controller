## AUTO-GENERATED by tools/nemo_ctl/gen_svh.py --chip -- do not edit by hand.
## Source: config/nemo_config.yaml (pin_map); package pins from tools/nemo_ctl/fmc_pins.py (= the verified
## XDC mapping, CLAUDE.md §5). Regenerate with: cd tools && python -m nemo_ctl.gen_svh --chip
## chip_out[i] drives chip input i, chip_in[j] reads chip output j (order: chip_pkg.sv).
## Rule (docs/decisions.md 2026-10-26): DRIVE 4 + SLEW SLOW on every FPGA output that drives
## the chip; PULLDOWN on the inputs, so a pin without the chip reads 0.

## ---- 100 MHz system clock and LD0-LD7 (verified lines, phase7_link_jtag_top.xdc) ----
set_property PACKAGE_PIN Y9 [get_ports {clk}]
set_property IOSTANDARD LVCMOS33 [get_ports {clk}]
create_clock -add -name sys_clk_pin -period 10.00 -waveform {0 5} [get_ports {clk}]
set_property PACKAGE_PIN T22 [get_ports {led[0]}]
set_property PACKAGE_PIN T21 [get_ports {led[1]}]
set_property PACKAGE_PIN U22 [get_ports {led[2]}]
set_property PACKAGE_PIN U21 [get_ports {led[3]}]
set_property PACKAGE_PIN V22 [get_ports {led[4]}]
set_property PACKAGE_PIN W22 [get_ports {led[5]}]
set_property PACKAGE_PIN U19 [get_ports {led[6]}]
set_property PACKAGE_PIN U14 [get_ports {led[7]}]
set_property IOSTANDARD LVCMOS33 [get_ports {led[*]}]

## ---- FPGA outputs -> chip inputs ----
## clk -> LA00_P (J3-0)
set_property PACKAGE_PIN M19 [get_ports {chip_out[0]}]
## reset -> LA01_P (J3-1)
set_property PACKAGE_PIN N19 [get_ports {chip_out[1]}]
## set -> LA02_P (J3-2)
set_property PACKAGE_PIN P17 [get_ports {chip_out[2]}]
## rst_dsa -> LA14_P (J3-14)
set_property PACKAGE_PIN K19 [get_ports {chip_out[3]}]
## pulse -> LA13_P (J3-13)
set_property PACKAGE_PIN L17 [get_ports {chip_out[4]}]
## s0_p -> LA10_P (J3-10)
set_property PACKAGE_PIN R19 [get_ports {chip_out[5]}]
## s1_p -> LA11_P (J3-11)
set_property PACKAGE_PIN N17 [get_ports {chip_out[6]}]
## s2_p -> LA12_P (J3-12)
set_property PACKAGE_PIN P20 [get_ports {chip_out[7]}]
## b0_dft -> LA15_P (J3-15)
set_property PACKAGE_PIN J16 [get_ports {chip_out[8]}]
## b1_dft -> LA20_P (J2-20)
set_property PACKAGE_PIN G20 [get_ports {chip_out[9]}]
## b2_dft -> LA21_P (J2-21)
set_property PACKAGE_PIN E19 [get_ports {chip_out[10]}]
## s0_dft -> LA22_P (J2-22)
set_property PACKAGE_PIN G19 [get_ports {chip_out[11]}]
## s1_dft -> LA23_P (J2-23)
set_property PACKAGE_PIN E15 [get_ports {chip_out[12]}]
## s2_dft -> LA24_P (J2-24)
set_property PACKAGE_PIN A18 [get_ports {chip_out[13]}]
## s3_dft -> LA25_P (J2-25)
set_property PACKAGE_PIN D22 [get_ports {chip_out[14]}]
## sipo_in -> LA03_P (J3-3)
set_property PACKAGE_PIN N22 [get_ports {chip_out[15]}]
## clk_sipo -> LA04_P (J3-4)
set_property PACKAGE_PIN M21 [get_ports {chip_out[16]}]
## cs -> LA05_P (J3-5)
set_property PACKAGE_PIN J18 [get_ports {chip_out[17]}]
## rst_sipo -> LA06_P (J3-6)
set_property PACKAGE_PIN L21 [get_ports {chip_out[18]}]
## clk_piso -> LA07_P (J3-7)
set_property PACKAGE_PIN T16 [get_ports {chip_out[19]}]
## shift -> LA08_P (J3-8)
set_property PACKAGE_PIN J21 [get_ports {chip_out[20]}]
## rst_piso -> LA09_P (J3-9)
set_property PACKAGE_PIN R20 [get_ports {chip_out[21]}]
set_property IOSTANDARD LVCMOS18 [get_ports {chip_out[*]}]
set_property DRIVE 4 [get_ports {chip_out[*]}]
set_property SLEW SLOW [get_ports {chip_out[*]}]

## ---- chip outputs -> FPGA inputs ----
## sipo_out <- LA16_P (J3-16)
set_property PACKAGE_PIN J20 [get_ports {chip_in[0]}]
## piso_out <- LA17_P (J2-17)
set_property PACKAGE_PIN B19 [get_ports {chip_in[1]}]
## dft0_buff <- LA18_P (J2-18)
set_property PACKAGE_PIN D20 [get_ports {chip_in[2]}]
## dft1_buff <- LA19_P (J2-19)
set_property PACKAGE_PIN G15 [get_ports {chip_in[3]}]
set_property IOSTANDARD LVCMOS18 [get_ports {chip_in[*]}]
set_property PULLDOWN true [get_ports {chip_in[*]}]

## ---- JTAG TCK from the BSCANE2 primitive (the PC link, as in phase7_link_jtag_top.xdc) ----
create_clock -name jtag_tck -period 33.333 [get_pins -hierarchical *u_bscan/TCK]
set_clock_groups -asynchronous -group [get_clocks sys_clk_pin] -group [get_clocks jtag_tck]
