$comment sample_cell record: 26 pins, every 100 ns (10 MHz), 3300 samples = 330 us, 0 before the trigger (now); first sample at -10 ns from RUN $end
$timescale 1ns $end
$scope module fpga $end
$var wire 1 ! clk $end
$var wire 1 " reset $end
$var wire 1 # set $end
$var wire 1 $ rst_dsa $end
$var wire 1 % pulse $end
$var wire 1 & s0_p $end
$var wire 1 ' s1_p $end
$var wire 1 ( s2_p $end
$var wire 1 ) b0_dft $end
$var wire 1 * b1_dft $end
$var wire 1 + b2_dft $end
$var wire 1 , s0_dft $end
$var wire 1 - s1_dft $end
$var wire 1 . s2_dft $end
$var wire 1 / s3_dft $end
$var wire 1 0 sipo_in $end
$var wire 1 1 clk_sipo $end
$var wire 1 2 cs $end
$var wire 1 3 rst_sipo $end
$var wire 1 4 clk_piso $end
$var wire 1 5 shift $end
$var wire 1 6 rst_piso $end
$var wire 1 7 sipo_out $end
$var wire 1 8 piso_out $end
$var wire 1 9 dft0_buff $end
$var wire 1 : dft1_buff $end
$var wire 1 ; clk_exp $end
$var wire 1 < reset_exp $end
$var wire 1 = set_exp $end
$var wire 1 > rst_dsa_exp $end
$var wire 1 ? pulse_exp $end
$var wire 1 @ s0_p_exp $end
$var wire 1 A s1_p_exp $end
$var wire 1 B s2_p_exp $end
$var wire 1 C b0_dft_exp $end
$var wire 1 D b1_dft_exp $end
$var wire 1 E b2_dft_exp $end
$var wire 1 F s0_dft_exp $end
$var wire 1 G s1_dft_exp $end
$var wire 1 H s2_dft_exp $end
$var wire 1 I s3_dft_exp $end
$var wire 1 J sipo_in_exp $end
$var wire 1 K clk_sipo_exp $end
$var wire 1 L cs_exp $end
$var wire 1 M rst_sipo_exp $end
$var wire 1 N clk_piso_exp $end
$var wire 1 O shift_exp $end
$var wire 1 P rst_piso_exp $end
$var wire 4 Q step $end
$upscope $end
$enddefinitions $end
